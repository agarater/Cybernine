<template>
  <div class="inventario-container">
    
    <div class="top-bar">
      <div class="search-input-container">
        <input 
          type="text" 
          v-model="searchQuery" 
          placeholder="Buscar productos..." 
          class="search-input" 
        />
        <span class="search-icon">🔍</span>
      </div>
      <button class="filter-button">
        <img src="/icons/filter-icon.png" alt="Filtrar" /> 
      </button>
    </div>

    <div class="scan-register-section">
      <h2>Registro de Movimiento</h2>
      <div class="scan-input-group">
        <label for="barcode">Código de Barras:</label>
        <input
          type="text"
          id="barcode"
          v-model="scannedCode"
          placeholder="Ingresa o escanea el código"
          @keyup.enter="buscarProducto" 
        />
        <button @click="buscarProducto" :disabled="!scannedCode" class="action-button">Buscar</button>
        <button @click="showScanner = true" class="action-button scan-button">📷 Escanear</button>
      </div>
      <p v-if="lookupError" class="error-message">{{ lookupError }}</p>
      
      <BarcodeScanner 
        v-if="showScanner" 
        @code-scanned="handleCodeScanned" 
        @scanner-closed="showScanner = false"
      /> 

      <div v-if="uiState !== 'initial'" class="product-form">
        
        <div v-if="uiState === 'newProduct'" class="new-product-fields">
          <h3>¡Producto Nuevo! Registra sus datos:</h3>
          
          <div class="input-field-container">
            <input 
              type="text" 
              placeholder="Producto (Ej: Leche) *" 
              v-model="productData.nombre" 
              maxlength="20"
              required 
              :class="{ 'input-error': formErrors.nombre }"
              @blur="validateField('nombre')"
              @input="validateField('nombre')"
            />
            <span v-if="formErrors.nombre" class="field-error-text">Campo obligatorio</span>
          </div>

          <div class="input-field-container">
            <input 
              type="text" 
              placeholder="Presentación (Ej: Entera 1L) *" 
              v-model="productData.presentacion" 
              maxlength="20"
              required 
              :class="{ 'input-error': formErrors.presentacion }"
              @blur="validateField('presentacion')"
              @input="validateField('presentacion')"
            />
            <span v-if="formErrors.presentacion" class="field-error-text">Campo obligatorio</span>
          </div>

          <div class="input-field-container">
            <input 
              type="text" 
              placeholder="Marca (Ej: Soprole) *" 
              v-model="productData.marca" 
              maxlength="15"
              required
              :class="{ 'input-error': formErrors.marca }"
              @blur="validateField('marca')"
              @input="validateField('marca')"
            />
            <span v-if="formErrors.marca" class="field-error-text">Campo obligatorio</span>
          </div>
          
          <div class="price-input-wrapper">
            <span class="currency-symbol">$</span>
            <input 
              type="text" 
              placeholder="Precio (Opcional)" 
              v-model="newProductDisplayPrice" 
              @input="handleNewProductPriceInput"
              class="price-input"
            />
            <div v-if="showNewProductWarning" class="warning-tooltip">
              ingrese sólo números
            </div>
          </div>

           <div class="input-field-container">
            <label for="newQuantity" class="field-label">Cantidad Inicial (Opcional):</label>
            <input 
              type="number" 
              id="newQuantity"
              placeholder="Ej: 10 (Deja vacío para 0)" 
              v-model.number="movementData.cantidad" 
              min="0"
            />
          </div>

          <div class="date-field-container">
            <label for="newDate" class="field-label">Fecha de Ingreso:</label>
            <input type="date" id="newDate" v-model="movementData.fechaVencimiento" />
            <p class="date-helper-text">De no cambiar la fecha, quedará la fecha del día de hoy por defecto.</p>
          </div>

          <div class="form-actions">
            <button @click="cancelarRegistro" class="action-button cancel-button" :disabled="saving">Cancelar</button>
            <button @click="registrarMovimientoNuevo" class="primary-button form-accept-button" :disabled="saving">
              {{ saving ? 'Guardando...' : 'Aceptar' }}
            </button>
          </div>
          <p v-if="saveError" class="error-message">{{ saveError }}</p>

        </div>

        <div v-if="uiState === 'productFound'" class="found-product-wrapper">
          
          <div class="found-details-left">
            <h3>Producto Encontrado:</h3>
            <p><strong>{{ productData.nombre }}</strong> - {{ productData.presentacion }}</p>
            <p v-if="productData.marca">Marca: {{ productData.marca }}</p>
            <p>Precio: ${{ productData.precio ? formatCurrency(productData.precio) : 'No definido' }}</p>
            <p class="current-stock-line">Stock Actual: <strong>{{ currentFoundStock }}</strong></p> 
          </div>

          <div class="found-stock-right">
             <span class="stock-label-prefix">Resultante:</span>
             <p class="stock-big-number preview-number" :class="{'stock-low': previewStock <= 5, 'stock-medium': previewStock > 5 && previewStock <= 10, 'stock-high': previewStock > 10}">
              <strong>{{ previewStock }}</strong> 
            </p>
          </div>

        </div>

        <div v-if="uiState === 'productFound'" class="movement-fields">
          <h3>Registrar Movimiento:</h3>
          <select v-model="movementData.tipo">
            <option value="entrada">Entrada (Compra)</option>
            <option value="salida">Salida (Venta)</option>
          </select>
          <input type="number" placeholder="Cantidad" v-model.number="movementData.cantidad" required min="1" />
          <input type="date" placeholder="Fecha Vencimiento (Opcional)" v-model="movementData.fechaVencimiento" />
          
          <button @click="registrarMovimientoExistente" :disabled="!movementData.cantidad || saving" class="action-button primary-button btn-block">
            {{ saving ? 'Guardando...' : 'Registrar Movimiento' }}
          </button>
          <p v-if="saveError" class="error-message">{{ saveError }}</p>
        </div>
      </div>
    </div> 
    
    <hr />

    <h2>Catálogo de Productos</h2>
    <div class="product-grid">
      <div v-for="producto in filteredProducts" :key="producto.id" class="product-card">
        
        <div class="card-top-section">
          <div class="card-header">
            <h3 class="product-name">{{ producto.nombre }}</h3>
            <div class="product-actions">
              <button @click="openEditModal(producto)" class="edit-button" title="Editar">✏️</button>
              <button @click="confirmDeleteProduct(producto)" class="delete-button" title="Eliminar">❌</button>
            </div>
          </div>
          
          <p v-if="producto.marca" class="product-info-line">Marca: <strong>{{ producto.marca }}</strong></p>
          <p class="product-info-line">Presentación: <strong>{{ producto.presentacion }}</strong></p>
          <p class="product-price-line">Precio: <strong>{{ producto.precio !== null ? '$' + formatCurrency(producto.precio) : 'No definido' }}</strong></p>
        </div>

        <div class="card-center-stock">
          <span class="stock-label-prefix">Cantidad:</span>
          <p class="stock-big-number" :class="{'stock-low': producto.calculatedStock <= 5, 'stock-medium': producto.calculatedStock > 5 && producto.calculatedStock <= 10, 'stock-high': producto.calculatedStock > 10}">
            <strong>{{ producto.calculatedStock }}</strong> 
          </p>
        </div>
        
        <div class="card-footer">
          <small class="product-code">#{{ extractBarcode(producto.id) }}</small>
          <button @click="ajustarStock(producto.id, producto.calculatedStock)" class="adjust-button">Ajustar Stock</button>
        </div>

      </div>
      <p v-if="filteredProducts.length === 0 && productsCatalog.length > 0">No se encontraron productos que coincidan con la búsqueda.</p>
      <p v-if="productsCatalog.length === 0">No hay productos registrados en el catálogo.</p>
    </div>

    <EditProductModal 
      :isVisible="showEditModal" 
      :product="selectedProductToEdit" 
      @close="closeEditModal" 
      @saved="recalculateAllStock"
    />
    <DeleteConfirmationModal
      :isVisible="showDeleteConfirmModal"
      :productName="productToDelete ? productToDelete.nombre : ''"
      @confirm="handleDeleteConfirmed"
      @cancel="showDeleteConfirmModal = false"
    />
    <nav class="bottom-nav">
      <router-link to="/app/inventario" class="nav-item router-link-active">
        <img src="/icons/catalog-icon.png" alt="Catálogo" /> <span>Catálogo</span>
      </router-link>
      <router-link to="/app/movimientos" class="nav-item">
        <img src="/icons/movements-icon.png" alt="Movimientos" />
        <span>Movimientos</span>
      </router-link>
      <router-link to="/app/sramaria" class="nav-item">
        <img src="/icons/ai-icon.png" alt="Sra. MarIA" />
        <span>Sra. MarIA</span>
      </router-link>
      <router-link to="/app/configuracion" class="nav-item">
        <img src="/icons/config-icon.png" alt="Configuración" />
        <span>Configuración</span>
      </router-link>
    </nav>
  </div>
</template>

<script setup>
import { ref, reactive, onMounted, onUnmounted, computed } from 'vue'; 
import { db, auth } from '@/firebase/config'; 
import { 
  collection, doc, getDoc, getDocs, setDoc, addDoc, query, where, onSnapshot, Timestamp, updateDoc 
} from 'firebase/firestore';
import BarcodeScanner from '@/components/BarcodeScanner.vue';
import EditProductModal from '@/components/EditProductModal.vue'; 
import DeleteConfirmationModal from '@/components/DeleteConfirmationModal.vue';
import { useRouter } from 'vue-router';

// --- ESTADO Y VARIABLES REACTIVAS ---
const scannedCode = ref('');
const uiState = ref('initial');
const lookupError = ref('');
const saveError = ref('');
const saving = ref(false);
const showScanner = ref(false); 
const searchQuery = ref('');

// Variables para el input de precio mejorado (Nuevo Producto)
const newProductDisplayPrice = ref('');
const showNewProductWarning = ref(false);
let newProductWarningTimeout = null;

// Estado para modales
const showEditModal = ref(false);
const selectedProductToEdit = ref(null); 
const showDeleteConfirmModal = ref(false);
const productToDelete = ref(null);

// NUEVO: Stock actual del producto encontrado al escanear
const currentFoundStock = ref(0);

// Estado para errores de validación del formulario
const formErrors = reactive({
  nombre: false,
  presentacion: false,
  marca: false
});
// Estado para saber si el usuario ha interactuado con el campo
const formTouched = reactive({
  nombre: false,
  presentacion: false,
  marca: false
});

const productData = reactive({ 
  nombre: '',
  presentacion: '',
  marca: '',
  precio: null,
  eliminado: false
});

const movementData = reactive({
  tipo: 'entrada',
  cantidad: null, 
  fechaVencimiento: null
});

const productsCatalog = ref([]); 
const router = useRouter(); 

// --- UTILIDAD DE FORMATO ---
const formatCurrency = (value) => {
  if (value === null || value === undefined) return '';
  let num = value.toString().replace(/\./g, '');
  return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
};

// --- MANEJO DEL INPUT DE PRECIO (Nuevo Producto) ---
const handleNewProductPriceInput = (event) => {
  const inputValue = event.target.value;
  const lastChar = inputValue.slice(-1);
  
  if (inputValue.length > 0 && isNaN(lastChar) && lastChar !== '.') {
    showNewProductWarning.value = true;
    if (newProductWarningTimeout) clearTimeout(newProductWarningTimeout);
    newProductWarningTimeout = setTimeout(() => {
      showNewProductWarning.value = false;
    }, 2000);
  }

  const cleanValue = inputValue.replace(/[^\d]/g, '');
  newProductDisplayPrice.value = formatCurrency(cleanValue);
  productData.precio = cleanValue === '' ? null : parseInt(cleanValue);
};

// --- FUNCIÓN DE VALIDACIÓN DE CAMPOS ---
const validateField = (field) => {
  formTouched[field] = true;
  if (!productData[field] || productData[field].trim() === '') {
    formErrors[field] = true;
  } else {
    formErrors[field] = false;
  }
};

// --- FUNCIÓN PARA CANCELAR REGISTRO ---
const cancelarRegistro = () => {
  resetForm();
};

const resetForm = () => {
  scannedCode.value = '';
  uiState.value = 'initial';
  Object.assign(productData, { nombre: '', presentacion: '', marca: '', precio: null });
  Object.assign(movementData, { tipo: 'entrada', cantidad: null, fechaVencimiento: null });
  newProductDisplayPrice.value = '';
  saveError.value = '';
  Object.keys(formErrors).forEach(key => formErrors[key] = false);
  Object.keys(formTouched).forEach(key => formTouched[key] = false);
  currentFoundStock.value = 0; // Resetear stock encontrado
};

// --- FUNCIONES AUXILIARES ---
const getUniqueProductId = (barcode) => {
  if (!auth.currentUser) return null;
  return `${auth.currentUser.uid}_${barcode}`;
};

const extractBarcode = (fullId) => {
  if (fullId && typeof fullId === 'string' && fullId.includes('_')) {
    const parts = fullId.split('_');
    if (parts.length > 1) {
       return parts[1]; 
    }
  }
  return fullId; 
};

// --- Computed Property para filtrar productos ---
const filteredProducts = computed(() => {
  if (!searchQuery.value) {
    return productsCatalog.value.filter(product => !product.eliminado);
  }
  const query = searchQuery.value.toLowerCase();
  return productsCatalog.value.filter(product => {
    if (product.eliminado) return false;

    const cleanBarcode = extractBarcode(product.id)?.toLowerCase() || '';
    return (
      product.nombre.toLowerCase().includes(query) ||
      product.presentacion.toLowerCase().includes(query) ||
      (product.marca && product.marca.toLowerCase().includes(query)) ||
      cleanBarcode.includes(query)
    );
  });
});

// --- NUEVO: Computed Property para previsualizar el stock resultante ---
const previewStock = computed(() => {
  const cantidadIngresada = movementData.cantidad || 0;
  if (movementData.tipo === 'entrada') {
    return currentFoundStock.value + cantidadIngresada;
  } else {
    // Salida
    return currentFoundStock.value - cantidadIngresada;
  }
});

const handleCodeScanned = (code) => {
  scannedCode.value = code; 
  showScanner.value = false; 
  buscarProducto(); 
};

// --- FUNCIÓN 1: Buscar Producto ---
const buscarProducto = async () => {
  if (!scannedCode.value) return;
  lookupError.value = '';
  uiState.value = 'loading';
  Object.keys(formErrors).forEach(key => formErrors[key] = false);
  Object.keys(formTouched).forEach(key => formTouched[key] = false);

  try {
    const uniqueId = getUniqueProductId(scannedCode.value);
    const productRef = doc(db, "products", uniqueId);
    const docSnap = await getDoc(productRef);

    if (docSnap.exists()) {
      const data = docSnap.data();
      if (data.eliminado) {
        lookupError.value = "Este producto ha sido eliminado del catálogo.";
        uiState.value = 'initial';
        return;
      }
      // Llenar datos del producto
      productData.nombre = data.nombre;
      productData.presentacion = data.presentacion;
      productData.marca = data.marca || '';
      productData.precio = data.precio; 
      
      // NUEVO: Buscar el stock actual de este producto en el catálogo ya cargado
      const foundInCatalog = productsCatalog.value.find(p => p.id === uniqueId);
      currentFoundStock.value = foundInCatalog ? foundInCatalog.calculatedStock : 0;

      uiState.value = 'productFound';
      movementData.cantidad = null; 
    } else {
      // Producto nuevo
      productData.nombre = '';
      productData.presentacion = '';
      productData.marca = '';
      productData.precio = null;
      newProductDisplayPrice.value = '';
      uiState.value = 'newProduct';
      movementData.cantidad = null; 
      currentFoundStock.value = 0; // Stock inicial es 0
      
      const today = new Date();
      const yyyy = today.getFullYear();
      let mm = today.getMonth() + 1; 
      let dd = today.getDate();
      if (dd < 10) dd = '0' + dd;
      if (mm < 10) mm = '0' + mm;
      movementData.fechaVencimiento = yyyy + '-' + mm + '-' + dd;
    }
    movementData.tipo = 'entrada';

  } catch (error) {
    console.error("Error buscando producto:", error);
    lookupError.value = "Error al buscar el código. Intenta de nuevo.";
    uiState.value = 'initial';
  }
};

// --- FUNCIÓN PARA REGISTRAR PRODUCTO NUEVO ---
const registrarMovimientoNuevo = async () => {
  validateField('nombre');
  validateField('presentacion');
  validateField('marca');

  if (formErrors.nombre || formErrors.presentacion || formErrors.marca) {
    saveError.value = "Por favor, completa los campos obligatorios marcados en rojo.";
    return;
  }

  if (!auth.currentUser) {
    saveError.value = "Error: Debes iniciar sesión.";
    return;
  }
  
  saving.value = true;
  saveError.value = '';

  try {
    const userId = auth.currentUser.uid;
    const fechaTimestamp = movementData.fechaVencimiento ? Timestamp.fromDate(new Date(movementData.fechaVencimiento)) : Timestamp.now();
    const uniqueId = getUniqueProductId(scannedCode.value);

    const productRef = doc(db, "products", uniqueId);
    await setDoc(productRef, {
      nombre: productData.nombre,
      presentacion: productData.presentacion,
      marca: productData.marca, 
      precio: productData.precio, 
      userId: userId,
      eliminado: false,
      fechaCreacion: fechaTimestamp 
    });

    const cantidadInicial = (movementData.cantidad === null || movementData.cantidad === '') ? 0 : movementData.cantidad;

    await addDoc(collection(db, "inventory_movements"), {
      productId: uniqueId,
      userId: userId,
      tipo: 'entrada', 
      cantidad: cantidadInicial,
      fecha: fechaTimestamp, 
      timestamp: Timestamp.now(), 
      esMovimientoInicial: true 
    });

    console.log("Producto nuevo y movimiento inicial registrado.");
    resetForm();
    
  } catch (error) {
    console.error("Error al registrar nuevo producto:", error);
    saveError.value = "Error al guardar: " + error.message;
  } finally {
    saving.value = false;
  }
};

// --- FUNCIÓN PARA REGISTRAR MOVIMIENTO (PRODUCTO EXISTENTE) ---
const registrarMovimientoExistente = async () => {
  if (!movementData.cantidad || movementData.cantidad <= 0) {
    saveError.value = "La cantidad debe ser mayor a cero para un movimiento.";
    return;
  }
  if (!auth.currentUser) {
    saveError.value = "Error: Debes iniciar sesión.";
    return;
  }
  
  saving.value = true;
  saveError.value = '';

  try {
    const userId = auth.currentUser.uid;
    const fechaTimestamp = movementData.fechaVencimiento ? Timestamp.fromDate(new Date(movementData.fechaVencimiento)) : Timestamp.now();
    const uniqueId = getUniqueProductId(scannedCode.value);

    await addDoc(collection(db, "inventory_movements"), {
      productId: uniqueId,
      userId: userId,
      tipo: movementData.tipo,
      cantidad: movementData.cantidad,
      fecha: fechaTimestamp,
      timestamp: Timestamp.now(),
    });

    console.log("Movimiento registrado:", movementData);
    resetForm();
    // Al guardar, el snapshot listener actualizará el catálogo automáticamente
    
  } catch (error) {
    console.error("Error al registrar movimiento:", error);
    saveError.value = "Error al guardar: " + error.message;
  } finally {
    saving.value = false;
  }
};


// --- FUNCIÓN AUXILIAR: Recalcular Stock (SIN CAMBIOS) ---
const recalculateAllStock = async () => {
  if (!auth.currentUser) return;
  const userId = auth.currentUser.uid;

  const currentCatalog = JSON.parse(JSON.stringify(productsCatalog.value)); 
  if (currentCatalog.length === 0) return;

  try {
    const movementsQuery = query(collection(db, "inventory_movements"), where("userId", "==", userId));
    const movementSnapshot = await getDocs(movementsQuery);
    
    const movementsByProduct = {};
    movementSnapshot.forEach(doc => {
      const movement = doc.data();
      if (!movementsByProduct[movement.productId]) {
        movementsByProduct[movement.productId] = [];
      }
      movementsByProduct[movement.productId].push(movement);
    });

    const updatedCatalog = currentCatalog.map(product => {
      let stock = 0;
      const productMovements = movementsByProduct[product.id] || [];

      productMovements.forEach(move => {
        if (move.tipo === 'entrada' || move.tipo === 'ajuste') { 
          stock += move.cantidad;
        } else if (move.tipo === 'salida') {
          stock -= move.cantidad;
        }
      });
      return { ...product, calculatedStock: stock };
    });

    productsCatalog.value = updatedCatalog;
  } catch (error) {
    console.error("Error recalculando stock:", error);
  }
};

// --- FUNCIÓN 4: Ajustar Stock Manualmente (SIN CAMBIOS) ---
const ajustarStock = async (productId, currentCalculatedStock) => {
  if (!auth.currentUser) {
    alert("Debes iniciar sesión.");
    return;
  }
  
  const productName = productsCatalog.value.find(p => p.id === productId)?.nombre || productId;
  const newTotalStockStr = prompt(`Stock actual de "${productName}": ${currentCalculatedStock}.\nIngresa la NUEVA cantidad TOTAL:`);
  
  if (newTotalStockStr === null) return;

  const newTotalStock = parseInt(newTotalStockStr);
  if (isNaN(newTotalStock) || newTotalStock < 0) {
    alert("Cantidad inválida. Ingresa un número positivo o cero.");
    return;
  }

  const diferencia = newTotalStock - currentCalculatedStock;
  if (diferencia === 0) {
    alert("No hay cambios en el stock.");
    return;
  }

  saving.value = true; 
  saveError.value = ''; 
  try {
    await addDoc(collection(db, "inventory_movements"), {
      productId: productId,
      userId: auth.currentUser.uid,
      tipo: 'ajuste', 
      cantidad: diferencia, 
      timestamp: Timestamp.now(), 
      motivo: 'Ajuste manual'
    });
  } catch (error) {
    console.error("Error al registrar ajuste:", error);
    saveError.value = "Error al guardar el ajuste: " + error.message;
  } finally {
    saving.value = false;
  }
};

// --- FUNCIONES DE GESTIÓN (Editar y Eliminar) (SIN CAMBIOS) ---
const openEditModal = (product) => {
  selectedProductToEdit.value = { ...product }; 
  showEditModal.value = true;
};
const closeEditModal = () => {
  showEditModal.value = false;
  selectedProductToEdit.value = null; 
};

const confirmDeleteProduct = (product) => {
  productToDelete.value = product;
  showDeleteConfirmModal.value = true;
};

const handleDeleteConfirmed = async () => {
  if (productToDelete.value) {
    await deleteProduct(productToDelete.value.id);
  }
  showDeleteConfirmModal.value = false;
  productToDelete.value = null;
};

const deleteProduct = async (productId) => {
  if (!auth.currentUser) return;
  try {
    const productRef = doc(db, "products", productId);
    await updateDoc(productRef, {
      eliminado: true,
      fechaEliminacion: Timestamp.now()
    });
    console.log(`Producto ${productId} eliminado lógicamente.`);
  } catch (error) {
    console.error("Error al eliminar producto:", error);
    alert("Error al eliminar el producto.");
  }
};

// --- INICIALIZACIÓN (SIN CAMBIOS) ---
let unsubscribeProducts = () => {}; 
let unsubscribeMovements = () => {};

onMounted(() => {
  const unsubscribeAuth = auth.onAuthStateChanged(user => {
    if (user) {
      const userId = user.uid;

      const productsQuery = query(collection(db, "products"), where("userId", "==", userId)); 
      unsubscribeProducts = onSnapshot(productsQuery, (productSnapshot) => {
        const catalogTemp = [];
        productSnapshot.forEach((doc) => {
          const data = doc.data();
          if (!data.eliminado) {
            catalogTemp.push({ 
              id: doc.id, 
              ...data,
              calculatedStock: 0
            });
          }
        });
        productsCatalog.value = catalogTemp; 
        recalculateAllStock(); 
      }, (error) => {
        console.error("Error escuchando productos:", error);
      });

      const movementsQuery = query(collection(db, "inventory_movements"), where("userId", "==", userId));
      unsubscribeMovements = onSnapshot(movementsQuery, (movementSnapshot) => {
        recalculateAllStock();
      }, (error) => {
        console.error("Error escuchando movimientos:", error);
      });
    } else {
      productsCatalog.value = [];
      if (unsubscribeProducts) unsubscribeProducts();
      if (unsubscribeMovements) unsubscribeMovements();
      router.push('/login'); 
    }
  });

  onUnmounted(() => {
    unsubscribeAuth();
  });
});

onUnmounted(() => {
  unsubscribeProducts();
  unsubscribeMovements();
});
</script>

